# Public, non-secret configuration only. Every NEXT_PUBLIC_ value is embedded in the browser bundle.
# Set these in Vercel > Project > Settings > Environment Variables, then redeploy.

# Canonical site origin used for canonical URLs, sitemap and Open Graph. Defaults to https://kiaratechs.com
NEXT_PUBLIC_SITE_URL=

# Verified company LinkedIn page URL. Link stays hidden while empty.
NEXT_PUBLIC_LINKEDIN_URL=

# Verified company WhatsApp number in international format, digits only (e.g. 447000000000). WhatsApp links stay hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
