# Public, non-secret configuration only. Every NEXT_PUBLIC_ value is embedded in the browser bundle.
# Set these in Vercel > Project > Settings > Environment Variables, then redeploy.

# Canonical site origin used for canonical URLs, sitemap and Open Graph. Defaults to https://kiaratechs.com
NEXT_PUBLIC_SITE_URL=

# Verified company LinkedIn page URL. Link stays hidden while empty.
NEXT_PUBLIC_LINKEDIN_URL=

# Verified company WhatsApp number in international format, digits only (e.g. 447000000000). WhatsApp links stay hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phase 2 form backend. Until BOTH are set, the forms show "not connected yet" and send nothing.
# API origin, https only (http://localhost:<port> is allowed for local development). Must match connect-src in vercel.json.
NEXT_PUBLIC_API_URL=
# Cloudflare Turnstile site key (public). Local testing: 1x00000000000000000000AA always passes,
# 3x00000000000000000000FF always asks the visitor to click. The matching secret goes to the backend only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
